# Local development environment configuration for ShopSphere infrastructure
# (docker-compose.yml). Copy this file to `.env` and adjust values as
# needed for your local machine. `.env` is git-ignored and must never be
# committed. These are LOCAL DEVELOPMENT DEFAULTS ONLY — never reuse these
# values in a shared or production environment.

# --- PostgreSQL ---
POSTGRES_DB=shopsphere
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=shopsphere
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
