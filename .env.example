# Local development environment configuration for ShopSphere infrastructure
# (docker-compose.yml). Copy this file to `.env` and adjust values as
# needed for your local machine. `.env` is git-ignored and must never be
# committed. These are LOCAL DEVELOPMENT DEFAULTS ONLY — never reuse these
# values in a shared or production environment.

# --- PostgreSQL (Docker container provisioning, docker-compose.yml) ---
POSTGRES_DB=shopsphere
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- PostgreSQL (shopsphere-api application datasource) ---
# DB_HOST is "localhost" when running shopsphere-api on the host machine
# against the Dockerized PostgreSQL above, or "postgres" (the Docker
# service name) once shopsphere-api itself runs inside shopsphere-network.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopsphere
DB_USERNAME=shopsphere
DB_PASSWORD=change-me

# --- Redis ---
REDIS_PORT=6379
# Used by shopsphere-api. localhost when the API runs on the host; use the
# Compose service name "redis" if the API later runs inside shopsphere-network.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=shopsphere
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Security / JWT (shopsphere-api) ---
# Required. HS256 signing secret, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Leave this placeholder unusable on purpose; never commit a real value.
JWT_SECRET=
JWT_ISSUER=shopsphere-api
# Access-token lifetime (Spring Duration format, e.g. 15m, 1h).
JWT_EXPIRATION=15m
# Comma-separated allowed browser origins, e.g. http://localhost:5173. Empty = none.
CORS_ALLOWED_ORIGINS=

# --- Observability (P1-T09) ---
# Password Prometheus uses to scrape /actuator/prometheus (HTTP Basic, user
# "prometheus"). Required for metrics: without it /actuator/metrics and
# /actuator/prometheus return 401 to everyone. Use the same value for the API
# and Prometheus. Generate one with: openssl rand -base64 24
ACTUATOR_USERNAME=prometheus
ACTUATOR_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Local default only; change it for anything shared.
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: directory for the rotated JSON log file when running on the host (default ./logs).
# LOG_DIR=logs
